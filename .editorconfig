# Baseline .editorconfig for all projects. Copy it to the project root as `.editorconfig` when a
# project has none, and adjust only for documented stack needs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Go uses tabs (gofmt decides; this only helps editors).
[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.{js,jsx,ts,tsx,mjs,cjs,json,yml,yaml,css,scss,html,vue}]
indent_size = 2

# Shell scripts use 2 spaces (stacks/scripts.md).
[*.{sh,bash}]
indent_size = 2

# Markdown uses trailing double spaces as hard line breaks.
[*.md]
trim_trailing_whitespace = false

# Windows-only scripts keep CRLF. PowerShell that CI also runs with pwsh on Linux or macOS
# stays LF: drop the PowerShell extensions from this section in that project (stacks/go-wails.md).
[*.{ps1,psm1,psd1,bat,cmd}]
end_of_line = crlf
